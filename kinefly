#!/bin/bash

# Unified Kinefly VR Script
# Works from host (starts container) or inside container (starts VRs)
# Usage: kinefly [VR_ID] [PORT]
#   - No arguments: starts all VRs (VR1-VR4) with default ports
#   - VR_ID (1-4): starts specific VR with default port (9871 + VR_ID - 1)
#   - VR_ID PORT: starts specific VR with custom port
#   - PORT (>=1024): legacy single camera mode (backward compatibility)
# Examples:
#   kinefly          # Start all VRs (VR1-VR4)
#   kinefly 1        # Start VR1 with default port 9871
#   kinefly 1 9999   # Start VR1 with custom port 9999
#   kinefly 9871     # Legacy: start single camera on port 9871

CONTAINER_NAME="kinefly_vr"

# Constants
MAX_VR=4

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Parse arguments: kinefly [VR_ID] [PORT]
# - No args: start all VRs (VR1-VR4)
# - VR_ID (1-4): start specific VR with default port
# - VR_ID PORT: start specific VR with custom port
# - PORT only (>=1024): legacy single camera mode (for backward compatibility)
VR_NUMBER=""
CUSTOM_PORT=""
LEGACY_MODE=false

if [ $# -ge 1 ]; then
    # Check if first argument is a valid VR_ID (1-4) or a port number (>=1024)
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        if [ "$1" -ge 1 ] && [ "$1" -le $MAX_VR ]; then
            # It's a VR_ID
            VR_NUMBER=$1
            if [ $# -ge 2 ]; then
                # Second argument is PORT
                CUSTOM_PORT=$2
            fi
        elif [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]; then
            # It's a port number (legacy single camera mode)
            LEGACY_MODE=true
            CUSTOM_PORT=$1
        else
            echo -e "${RED}❌ Invalid argument: $1${NC}"
            echo "First argument must be VR_ID (1-$MAX_VR) or PORT (1024-65535)"
            exit 1
        fi
    else
        echo -e "${RED}❌ Invalid argument: $1${NC}"
        echo "Arguments must be numbers"
        exit 1
    fi
fi

# Check if running inside container
if [ -f /.dockerenv ]; then
    # Running inside container
    if [ "$LEGACY_MODE" = true ]; then
        # Legacy single camera mode
        /opt/Kinefly_docker/start-kinefly-all.sh ${CUSTOM_PORT:+"$CUSTOM_PORT"}
    else
        # VR mode - use the start script directly
        # Build arguments properly - pass empty string if not provided
        ARGS=""
        if [ ! -z "$VR_NUMBER" ]; then
            ARGS="$VR_NUMBER"
            if [ ! -z "$CUSTOM_PORT" ]; then
                ARGS="$ARGS $CUSTOM_PORT"
            fi
        fi
        /opt/Kinefly_docker/start-kinefly-vr.sh $ARGS
    fi
    EXIT_CODE=$?
    
    # Always drop to console after script ends (success or failure)
    echo ""
    echo -e "${YELLOW}Script ended (exit code: $EXIT_CODE). Dropping to container console...${NC}"
    echo -e "${GREEN}You can now run commands manually or restart with:${NC}"
    echo -e "  kinefly          # Start all VRs"
    echo -e "  kinefly 1        # Start VR1 only"
    echo -e "  kinefly 2 9999   # Start VR2 with custom port"
    exec /bin/bash
else
    # Running on host - start container and sync configs
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    
    # Validate VR number if provided
    if [ ! -z "$VR_NUMBER" ]; then
        if ! [[ "$VR_NUMBER" =~ ^[0-9]+$ ]] || [ "$VR_NUMBER" -lt 1 ] || [ "$VR_NUMBER" -gt $MAX_VR ]; then
            echo -e "${RED}❌ Invalid VR number: $VR_NUMBER${NC}"
            echo "Usage: $0 [VR_ID] [PORT]"
            echo "  VR_ID (1-$MAX_VR): Start specific VR (default: all VRs)"
            echo "  PORT: Custom ZMQ port (default: 9871 + VR_ID - 1)"
            echo ""
            echo "Examples:"
            echo "  $0              # Start all VRs (VR1-VR${MAX_VR})"
            echo "  $0 1            # Start VR1 with default port 9871"
            echo "  $0 1 9999      # Start VR1 with custom port 9999"
            exit 1
        fi
        if [ ! -z "$CUSTOM_PORT" ]; then
            if ! [[ "$CUSTOM_PORT" =~ ^[0-9]+$ ]] || [ "$CUSTOM_PORT" -lt 1 ] || [ "$CUSTOM_PORT" -gt 65535 ]; then
                echo -e "${RED}❌ Invalid port: $CUSTOM_PORT${NC}"
                echo "Port must be a number between 1 and 65535"
                exit 1
            fi
            echo -e "${YELLOW}🚀 Starting Kinefly VR${VR_NUMBER} (Port: ${CUSTOM_PORT})${NC}"
        else
            echo -e "${YELLOW}🚀 Starting Kinefly VR${VR_NUMBER}${NC}"
        fi
    else
        echo -e "${YELLOW}🚀 Starting Kinefly All VRs (VR1-VR${MAX_VR})${NC}"
    fi
    
    # Function to sync configs on exit
    cleanup_and_sync() {
        "$SCRIPT_DIR/sync-config-from-container.sh" "$CONTAINER_NAME" > /dev/null 2>&1
        # Stop and remove container
        docker stop "$CONTAINER_NAME" > /dev/null 2>&1
        docker rm "$CONTAINER_NAME" > /dev/null 2>&1
    }
    
    # Set up trap to sync on exit
    trap cleanup_and_sync EXIT INT TERM
    
    # Setup X11 for Linux
    xhost +local:docker
    
    # Cleanup any existing container
    docker rm -f ${CONTAINER_NAME} > /dev/null 2>&1
    
    # Start container in background first
    docker run -d \
        --privileged \
        --net=host \
        --env="DISPLAY=${DISPLAY:-:0}" \
        --env="QT_X11_NO_MITSHM=1" \
        --volume="/tmp/.X11-unix:/tmp/.X11-unix:rw" \
        --volume="$(pwd)/_internal/start-kinefly-vr.sh:/opt/Kinefly_docker/start-kinefly-vr.sh:ro" \
        --name ${CONTAINER_NAME} \
        kinefly \
        sleep infinity > /dev/null 2>&1
    
    # Wait for container to be ready
    sleep 0.5
    
    # Sync configurations FROM host TO container at startup
    "$SCRIPT_DIR/sync-config-to-container.sh" "$CONTAINER_NAME" > /dev/null 2>&1
    
    # Copy this script into container so it can be called recursively
    docker cp "$0" "${CONTAINER_NAME}:/opt/Kinefly_docker/kinefly" > /dev/null 2>&1
    docker exec ${CONTAINER_NAME} chmod +x /opt/Kinefly_docker/kinefly 2>/dev/null || true
    # Note: start-kinefly-vr.sh is mounted as volume, so permissions come from host file
    
    # Now exec into container and run the script
    # The script will drop to bash console after it exits (success or failure)
    # Use -it if TTY is available, otherwise use -i
    # Build command with proper argument handling
    CMD="/opt/Kinefly_docker/kinefly"
    if [ ! -z "$VR_NUMBER" ]; then
        CMD="$CMD $VR_NUMBER"
        if [ ! -z "$CUSTOM_PORT" ]; then
            CMD="$CMD $CUSTOM_PORT"
        fi
    fi
    if [ -t 0 ]; then
        docker exec -it ${CONTAINER_NAME} /bin/bash -c "$CMD"
    else
        docker exec -i ${CONTAINER_NAME} /bin/bash -c "$CMD"
    fi
    
    # Sync will happen automatically via trap on exit
fi
